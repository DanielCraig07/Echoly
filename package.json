{
  "name": "echoly",
  "version": "0.0.59",
  "private": true,
  "description": "Echoly - AI-first Modern Intelligent IDE",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-pty-perms.js && node scripts/fix-mac-local-network.js",
    "dev": "node scripts/fix-pty-perms.js && node scripts/fix-mac-local-network.js && npm run dev -w @echoly/desktop",
    "build": "npm run build -w @echoly/desktop",
    "build:runner": "node scripts/build-runner.mjs",
    "audit:wiring": "node scripts/audit-ui-wiring.mjs",
    "verify:embedding": "tsx scripts/verify-embedding.mts",
    "preview": "npm run preview -w @echoly/desktop",
    "pack": "npm run pack -w @echoly/desktop",
    "pack:win32": "npm run pack:win32 -w @echoly/desktop",
    "pack:win:publish": "npm run pack:win:publish -w @echoly/desktop",
    "pack:mac": "npm run pack:mac -w @echoly/desktop",
    "pack:mac:arm64": "npm run pack:mac:arm64 -w @echoly/desktop",
    "pack:mac:x64": "npm run pack:mac:x64 -w @echoly/desktop",
    "pack:mac:publish": "npm run pack:mac:publish -w @echoly/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "probe-llm": "npm run probe -w @deepseek-ide/llm",
    "build-cursor-ext": "npm run build -w packages/cursor-extension",
    "package-cursor-ext": "npm run build -w packages/cursor-extension && node scripts/package-cursor-ext.js",
    "sync-version": "node scripts/sync-version.js",
    "release": "node scripts/release.js",
    "test:coverage": "vitest run --coverage",
    "verify:extension": "npx vite-node scripts/verify-extension-install.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.11",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true
  }
}
