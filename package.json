{
  "name": "echoly",
  "version": "0.0.15",
  "private": true,
  "description": "Echoly - AI-first Modern Intelligent IDE",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-pty-perms.js && node scripts/fix-mac-local-network.js",
    "dev": "node scripts/fix-pty-perms.js && node scripts/fix-mac-local-network.js && npm run dev -w @deepseek-ide/desktop",
    "build": "npm run build -w @deepseek-ide/desktop",
    "pack": "npm run pack -w @deepseek-ide/desktop",
    "pack:win32": "npm run pack:win32 -w @deepseek-ide/desktop",
    "pack:win:publish": "npm run pack:win:publish -w @deepseek-ide/desktop",
    "pack:mac": "npm run pack:mac -w @deepseek-ide/desktop",
    "pack:mac:arm64": "npm run pack:mac:arm64 -w @deepseek-ide/desktop",
    "pack:mac:x64": "npm run pack:mac:x64 -w @deepseek-ide/desktop",
    "pack:mac:publish": "npm run pack:mac:publish -w @deepseek-ide/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "probe-llm": "npm run probe -w @deepseek-ide/llm",
    "build-cursor-ext": "npm run build -w packages/cursor-extension",
    "package-cursor-ext": "npm run build -w packages/cursor-extension && node scripts/package-cursor-ext.js",
    "sync-version": "node scripts/sync-version.js",
    "release": "node scripts/release.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.11",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true
  }
}
